<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <!-- Tether / ROV mode: pin DDS to the ethernet interface connected to the internal switch. -->
      <!-- If your ethernet NIC name differs, update it with `ip -br link`. -->
      <Interfaces>
        <NetworkInterface name="enP8p1s0" />
      </Interfaces>
      <AllowMulticast>default</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Discovery>
      <!-- Help same-host containers (auv + web_video_server) find each other. -->
      <ParticipantIndex>auto</ParticipantIndex>
      <Peers>
        <Peer address="127.0.0.1"/>
      </Peers>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
      <Watermarks>
        <!-- 1280x720 rgb8 ≈ 2.8MB/frame; keep headroom for a few samples. -->
        <WhcHigh>16MB</WhcHigh>
      </Watermarks>
    </Internal>
  </Domain>
</CycloneDDS>

