<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <!-- Surface / extender mode: pin DDS to the Wi‑Fi extender interface. -->
      <!-- If your Wi‑Fi NIC name differs, update it with `ip -br link`. -->
      <Interfaces>
        <NetworkInterface name="wlx8c902d14c273" />
      </Interfaces>
      <AllowMulticast>default</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
    <Discovery>
      <!-- Keep ParticipantIndex=auto for unicast Peers; raise cap so many
           sensor nodes can start (default ~9–32 is too low for full stack). -->
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers>
        <Peer address="127.0.0.1"/>
      </Peers>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize min="10MB"/>
      <Watermarks>
        <!-- 1280x720 rgb8 ≈ 2.8MB/frame; keep headroom for a few samples. -->
        <WhcHigh>16MB</WhcHigh>
      </Watermarks>
    </Internal>
  </Domain>
</CycloneDDS> 